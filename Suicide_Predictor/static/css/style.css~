.card {
        background-color: #fff;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 10px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .card-body {
        padding: 20px;
    }

    .card-title {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .card-text {
        font-size: 18px;
        margin-bottom: 20px;
    }


    .centered-card {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 50%;
    }
    .banner_taital {
      font-family: 'Open Sans', sans-serif;
      font-size: 44px; /* increase font size */
      font-weight: 700; /* add font weight */
      text-transform: uppercase; /* add text transform */
    }